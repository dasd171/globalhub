# ─────────────────────────────────────────────────────────────────────────────
# GlobalHub configuration. Copy to .env and edit. NEVER commit a real .env.
# Validate with:  pnpm env:check
# In NODE_ENV=production the API/worker refuse to start with weak or missing secrets.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public demo deployments only: allows the mock payment provider in production.
DEMO_MODE=false

# Database & cache (docker-compose service names shown; use 127.0.0.1 for local dev)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql://globalhub:change-me-to-a-long-random-password@postgres:5432/globalhub
REDIS_URL=redis://redis:6379

# Secrets — generate with: openssl rand -hex 32
AUTH_SECRET=
APP_ENCRYPTION_KEY=

# URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Where the Next.js server reaches the API (inside docker: http://api:4000)
API_INTERNAL_URL=http://api:4000
TRUST_PROXY=false
COOKIE_SECURE=

# File storage: local (dev) or s3 (MinIO / AWS S3 / R2 …)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_BYTES=10485760

# AI assistant (optional). none = rule-based parsing + glossary translation.
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_DAILY_USER_LIMIT=50

# Email: none (not sent, shown as NOT_CONFIGURED) | log (dev: printed, still NOT_CONFIGURED) | resend
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=GlobalHub <no-reply@example.com>

# Payments: mock (dev/demo, NO REAL MONEY) | manual (bank transfer registration) | stripe
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping: mock (DEMO estimates) | manual (supplier enters carrier/tracking)
SHIPPING_PROVIDER=mock

# Federation (optional node network)
FEDERATION_ENABLED=false
NODE_ID=my-globalhub-node
NODE_NAME=My GlobalHub Node
NODE_PUBLIC_URL=
# Generate with: pnpm node:keygen
NODE_KEY_ID=k1
NODE_PRIVATE_KEY=
# What this node publishes: products,suppliers,buying_requests,rfq_inbox
NODE_PUBLIC_SCOPES=products,suppliers
# DEV/TEST ONLY: allow federation over http to private addresses (two nodes on localhost)
FEDERATION_ALLOW_PRIVATE_NETWORK=false

# Limits & logging
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info

# Seed demo data (clearly marked [DEMO]) — never in production unless DEMO_MODE=true
SEED_DEMO=false
SEED_DEMO_PASSWORD=
