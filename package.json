{
  "name": "globalhub",
  "private": true,
  "version": "0.1.0",
  "description": "GlobalHub \u2014 Open-Source Global Sourcing Network",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @globalhub/database generate",
    "db:migrate": "pnpm --filter @globalhub/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @globalhub/database migrate:dev",
    "db:seed": "pnpm --filter @globalhub/database seed",
    "env:check": "tsx scripts/check-env.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "node:keygen": "tsx scripts/generate-node-key.ts",
    "services:local": "bash scripts/local-services.sh start"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "argon2",
      "sharp"
    ]
  },
  "dependencies": {
    "@globalhub/core": "workspace:*",
    "@globalhub/federation": "workspace:*",
    "@globalhub/shared": "workspace:*",
    "@globalhub/database": "workspace:*",
    "@globalhub/connectors": "workspace:*"
  }
}